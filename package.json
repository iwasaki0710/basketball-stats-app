{
  "name": "courtvision",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib tests scripts *.ts *.mjs *.json README.md docs .github",
    "format:check": "prettier --check app components lib tests scripts *.ts *.mjs *.json README.md docs .github",
    "db:bundle": "node scripts/bundle-schema.mjs",
    "setup:check": "node --import tsx scripts/check-setup.ts",
    "setup:verify": "node --import tsx scripts/check-setup.ts --network",
    "test:auth": "node scripts/test-auth.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
